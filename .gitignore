# Local assignment inputs, working specifications and discussion history.
.agents/inputs
.agents/specs
.agents/raw
.agents/investigations

# Original customer workbooks and private preparation/review outputs.
.agents/samples
data/private/

# One-off local preparation tooling; excluded from the HW submission.
/tools/po-data-prep/

# Python bytecode and interpreter caches.
__pycache__/
*.py[cod]

# Local Python environments and check caches; the default workflow runs in Docker.
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local credentials and environment overrides; only harmless examples are tracked.
.env
.env.*
!.env.example
!.env.compose.example
!.env.archive.example

# Generated HW-01 runtime output, caches, restores, logs and detailed reports.
# Original exports are retained locally and archived; ignore rules do not back
# them up or remove evidence already tracked in earlier commits.
/hw-01/results/*
!/hw-01/results/submission/
/hw-01/results/submission/*

# Only explicitly reviewed compact snapshots belong in the submission tree in Git.
# Keep each allowlist narrow so new raw exports/detailed reports stay ignored.
!/hw-01/results/submission/catalog-row-diagnostics-20261024/
/hw-01/results/submission/catalog-row-diagnostics-20261024/*
!/hw-01/results/submission/catalog-row-diagnostics-20261024/summary.json
!/hw-01/results/submission/catalog-row-diagnostics-20261024/files.sha256.json

!/hw-01/results/submission/v2-baseline-review-20261025/
/hw-01/results/submission/v2-baseline-review-20261025/*
!/hw-01/results/submission/v2-baseline-review-20261025/README.md
!/hw-01/results/submission/v2-baseline-review-20261025/summary.json
!/hw-01/results/submission/v2-baseline-review-20261025/evidence-index.json

# Compact archive indexes and verified-upload receipts live outside results/
# under hw-01/archive-index/ and remain available for explicit review/commit.
