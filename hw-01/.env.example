# Offline preflight needs no credentials; omit the key until provider execution.
# Only the app service loads this optional file as runtime environment values.
# Local model helpers/checks receive no provider credentials. Setup never invokes a provider.
# Compose resource/deadline controls live in .env.compose; see .env.compose.example.
# OPENROUTER_API_KEY=replace-with-your-own-key
HW01_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HW01_OLLAMA_BASE_URL=http://ollama:11434
