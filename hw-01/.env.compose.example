# Public Compose controls. Copy to .env.compose for this machine's overrides.
# Make loads .env.compose when present, otherwise this example. Shell values win.
# Keep provider credentials in .env; local helpers receive only allowlisted controls.

# Server allocation. The Docker Desktop VM needs memory beyond this container limit.
# The recorded M2 Pro baseline used 10g with a 12 GB Docker VM allocation.
HW01_OLLAMA_MEMORY_LIMIT=7g
HW01_CONTEXT_LENGTH=32768

# Native Python-container route to the already running desktop Ollama app.
# MODE=native selects this endpoint and never starts container Ollama.
HW01_NATIVE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# HTTP readiness: overall wait, poll interval and individual metadata request timeout.
HW01_SETUP_WAIT_SECONDS=60
HW01_SETUP_POLL_SECONDS=1
HW01_SETUP_REQUEST_SECONDS=5

# Explicit first-time initialization and model loading; existing weights are reused.
HW01_SETUP_PULL_SECONDS=1800
HW01_SETUP_LOAD_SECONDS=300
HW01_SETUP_KEEP_ALIVE_SECONDS=600

# Representative one-token diagnostics: overall budget and each request's timeout.
# local-capacity explicitly uses a separate 3600-second overall budget.
HW01_SETUP_CAPACITY_SECONDS=900
HW01_SETUP_MEASUREMENT_SECONDS=600
