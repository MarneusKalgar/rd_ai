# Prefer `make hw01-archive-store-init` to generate unique local credentials.
# For an existing S3-compatible store, configure only HW01_ARCHIVE_* below.
HW01_ARCHIVE_ENDPOINT_URL=http://garage:3900
HW01_ARCHIVE_REGION=garage
HW01_ARCHIVE_BUCKET=hw01-evidence
HW01_ARCHIVE_ACCESS_KEY=replace-with-access-key
HW01_ARCHIVE_SECRET_KEY=replace-with-secret-key

# Used only by the optional single-node Garage server on first initialization.
GARAGE_DEFAULT_ACCESS_KEY=replace-with-the-same-access-key
GARAGE_DEFAULT_SECRET_KEY=replace-with-the-same-secret-key
GARAGE_DEFAULT_BUCKET=hw01-evidence
