# Prefer `make archive-store-init` to generate unique local credentials.
# For an existing S3-compatible store, configure only DI_ARCHIVE_* below.
DI_ARCHIVE_ENDPOINT_URL=http://garage:3900
DI_ARCHIVE_REGION=garage
DI_ARCHIVE_BUCKET=hw01-evidence
DI_ARCHIVE_ACCESS_KEY=replace-with-access-key
DI_ARCHIVE_SECRET_KEY=replace-with-secret-key

# Used only by the optional single-node Garage server on first initialization.
GARAGE_DEFAULT_ACCESS_KEY=replace-with-the-same-access-key
GARAGE_DEFAULT_SECRET_KEY=replace-with-the-same-secret-key
GARAGE_DEFAULT_BUCKET=hw01-evidence
